# 피드백 접수: 구글 폼으로 넘긴다 (src/app/api/feedback/route.ts).
#
# 만드는 법:
# 1. 구글 폼을 만든다. 질문 4개, 전부 단답/장문 텍스트(유형·본문·이메일·메타), 전부 "선택".
#    응답 탭 → 스프레드시트에 연결하면 시트에 자동으로 쌓인다.
# 2. 폼 보내기 → 링크의 /d/e/와 /viewform 사이 토막이 FORM_ID다.
# 3. 미리 채워진 링크 만들기(⋮ 메뉴)로 아무 값이나 넣고 링크를 받으면
#    각 질문의 entry.숫자 id가 쿼리스트링에 보인다.
# 4. 아래 다섯 값을 채워 Vercel 환경변수(및 로컬 .env.local)에 넣는다.
#    다섯 개가 다 있어야 켜진다. 하나라도 없으면 API가 503("아직 준비 안 됨")을 준다.
# 5. 배포 후 폼에서 한 번 직접 보내 시트에 꽂히는지 확인할 것:
#    구글 폼은 entry id가 틀려도 200을 돌려주므로 여기까지가 진짜 검증이다.
FEEDBACK_GOOGLE_FORM_ID=
FEEDBACK_ENTRY_CATEGORY=
FEEDBACK_ENTRY_BODY=
FEEDBACK_ENTRY_EMAIL=
FEEDBACK_ENTRY_META=
