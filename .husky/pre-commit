# 1) 25MB 초과 파일 차단 (.claude/rules/assets.md 절대 한도)
limit=26214400
oversized=""
for f in $(git diff --cached --name-only --diff-filter=AM); do
  if [ -f "$f" ]; then
    size=$(wc -c < "$f" | tr -d ' ')
    if [ "$size" -gt "$limit" ]; then
      oversized="$oversized\n  $f ($((size / 1048576))MB)"
    fi
  fi
done
if [ -n "$oversized" ]; then
  printf "✖ 25MB 초과 파일이 스테이징되어 있습니다. 압축 후 커밋하세요 (/optimize-asset 참고):$oversized\n"
  exit 1
fi

# 2) 스테이징된 파일만 Biome 검사 (WASM 판)
#
# CLI(`biome check --staged`)가 아니라 WASM 판을 쓴다. biome.exe는 서명이 없어서
# Windows Smart App Control이 실행 자체를 막고("An Application Control policy has
# blocked this file"), SAC는 예외 목록이 없으며 한 번 끄면 Windows 재설치 전까지
# 다시 켤 수 없다. 훅이 도는 게 보안 설정을 무르는 것보다 낫다. WASM은 node 안에서
# 돌아 SAC가 볼 exe가 없고, 같은 2.5.2라 판정도 같다. 자세한 내용은 스크립트 머리말.
node scripts/biome-wasm.mjs
